<<setup, include=FALSE>>=
library(knitr)
opts_chunk$set(
  echo       = FALSE,   # o codigo mora em entrega-1-pergunta.R
  message    = FALSE,
  warning    = FALSE,
  fig.align  = "center",
  out.width  = "0.62\\linewidth",
  fig.width  = 5.6,
  fig.height = 2.1
)
options(OutDec = ",", digits = 4)
@

<<dados, include=FALSE>>=
# REGRA: nada de acento dentro de string de R; acento so em LaTeX.
esc <- read.csv("entrega-1-escalas.csv")
res <- read.csv("entrega-1-resultados.csv")
r   <- setNames(res$media, res$medida)
rdp <- setNames(res$dp, res$medida)

f1 <- function(x, d = 1) formatC(x, format = "f", digits = d, big.mark = ".", decimal.mark = ",")
f0 <- function(x) formatC(x, format = "d", big.mark = ".")

y      <- esc$T3
n      <- nrow(esc)
p.col  <- 7
mm     <- model.matrix(~ log1p(peso.t) + log1p(teu) + log1p(n.part) +
                         natureza + navegacao + terminal + factor(mes), data = esc)
p.dum  <- ncol(mm) - 1
n.por.p <- n / (p.dum + 1)

# --- vazamento: correlacao de todas as colunas numericas com T3 ---------
vaz  <- c("dur.datas", "TAtracado", "TEstadia", "T1", "T2", "T4")
cc   <- abs(cor(esc[, c("T3", "peso.t", "teu", "n.part", vaz)],
                use = "pairwise.complete.obs")[, "T3"])
cc   <- sort(cc[names(cc) != "T3"], decreasing = TRUE)
leg  <- data.frame(log.teu = log1p(esc$teu), log.part = log1p(esc$n.part),
                   log.peso = log1p(esc$peso.t))
cl   <- sort(abs(cor(leg, y)[, 1]), decreasing = TRUE)
tt   <- function(nm) paste0("\\texttt{", nm, "}")

# --- balanco (pergunta 2) e faltantes ------------------------------------
corte  <- r["corte"]
longa  <- sum(y > corte)
curta  <- n - longa
falt   <- colSums(is.na(esc))
falt   <- sort(falt[falt > 0], decreasing = TRUE)
texto.falt <- paste(paste0(tt(names(falt)), " ", f0(falt)), collapse = "; ")
falt.pred  <- sum(is.na(esc[, c("peso.t", "teu", "n.part", "natureza",
                                "navegacao", "terminal", "mes")]))
ganho1 <- 100 * (1 - r["rmse.lm.h"] / r["rmse.base"])
@

